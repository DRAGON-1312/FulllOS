 // returns 0 if out of disk space.
+// bmap() sẽ trả về địa chỉ block thật trên disk. (voi bn la logic block number)
 static uint
 bmap(struct inode *ip, uint bn)
 {
   uint addr, *a;
+  uint indirect_index, data_index; // used for part 3
   struct buf *bp;
 
-  if(bn < NDIRECT){
-    if((addr = ip->addrs[bn]) == 0){
+  // === Phần 1: Direct blocks (bn = 0..10) === 
+  if(bn < NDIRECT){ // Nếu bn nằm trong 0..10 thì đây là direct block.
+    // addr = ip->addrs[bn]: lấy địa chỉ disk block thật từ inode.
+    if((addr = ip->addrs[bn]) == 0){ // Nếu addr == 0, nghĩa là file chưa có block này. Khi đó cấp phát block mới
       addr = balloc(ip->dev);
       if(addr == 0)
         return 0;
-      ip->addrs[bn] = addr;
+      ip->addrs[bn] = addr; // lưu địa chỉ mới vào inode
     }
-    return addr;
+    return addr; // trả về địa chỉ block thật
   }
-  bn -= NDIRECT;
+  bn -= NDIRECT; // Sau khi xử lý xong 11 direct blocks, nếu bn không thuộc vùng direct nữa
+ // ta trừ đi NDIRECT để chuyển bn sang index tương đối cho vùng tiếp theo.
 
+  // === Phần 2: Singly-indirect blocks (bn = 0..255) ===
   if(bn < NINDIRECT){
     // Load indirect block, allocating if necessary.
-    if((addr = ip->addrs[NDIRECT]) == 0){
-      addr = balloc(ip->dev);
+    // addr = ip->addrs[NDIRECT]: tức là ip->addrs[11] -- không trỏ thẳng tới data block ma Nó trỏ tới một block trung gian.
+    if((addr = ip->addrs[NDIRECT]) == 0){ // Nếu inode chưa có singly-indirect block,
+      addr = balloc(ip->dev);             // thì cấp phát 1 block mới để làm singly-indirect block.
       if(addr == 0)
         return 0;
-      ip->addrs[NDIRECT] = addr;
+      ip->addrs[NDIRECT] = addr; // lưu địa chỉ disk block thật của indirect block. (gia su addr = 500)
+      // Bây giờ inode nhớ rằng: indirect block nằm ở disk block 500
+    }
+    // Vì sao phải bread()? Vì hiện tại mình chỉ biết: indirect block nằm ở disk block 500 Nhưng mình chưa biết bên trong block 500 đang chứa những gì. Mà block 500 là một bảng địa chỉ: entry 0 → data block của file, entry 1 → data block của file, ...
+    bp = bread(ip->dev, addr); // để đọc nội dung của indirect block đó vào RAM (buffer cache), sau đó mới sửa được a[bn] (đọc disk block 500 vào RAM thông qua buffer cache). Sau dòng này, bp là một struct buffer đang giữ nội dung block 500.
+    a = (uint*)bp->data; // bp->data là nội dung raw bytes của block. Ta ép kiểu nó thành mảng uint.
+                        // Vì mỗi địa chỉ block là uint nen hãy xem 1024 raw bytes trong bp->data như một mảng uint gồm 256 phần tử , nên sau dòng này ta có thể xem block đó như: a[0], a[1], ..., a[255]. Mỗi a[i] là địa chỉ của một data block. 
+                        
+    // Lấy entry thứ bn trong singly-indirect block.
+    if((addr = a[bn]) == 0){ // Nếu entry đó chưa có data block
+      addr = balloc(ip->dev); // thì cấp phát data block mới.
+      if(addr){
+        a[bn] = addr; // Sau đó ghi địa chỉ data block mới vào a[bn].
+        log_write(bp); // báo với log system rằng block này đã bị thay đổi. (Vì mình vừa sửa nội dung của indirect block trên buffer)
+      }
     }
+    brelse(bp); // // giải phóng buffer sau khi đọc/sửa xong
+    return addr;
+  }
+  bn -= NINDIRECT;
+  
+  // === Phần 3: Doubly-indirect blocks (bn = 0..65535) ===
+  if(bn < NINDIRECT * NINDIRECT){
+    // --- Bước 3a: Load doubly-indirect block ---
+    // addrs[NDIRECT+1] chứa địa chỉ của doubly-indirect block
+    if ((addr = ip->addrs[NDIRECT + 1]) == 0) {
+      addr = balloc(ip->dev);
+      if (addr == 0)
+        return 0;
+      ip->addrs[NDIRECT + 1] = addr;
+    }
+  
+
+    // --- Bước 3b: Tìm singly-indirect block bên trong ---
+    // bn / NINDIRECT = index vào doubly-indirect block
+    // Ví dụ: bn=300 → 300/256 = 1 → lấy indirect block thứ 1
     bp = bread(ip->dev, addr);
     a = (uint*)bp->data;
-    if((addr = a[bn]) == 0){
+    
+    indirect_index = bn / NINDIRECT;
+    
+    if ((addr = a[indirect_index]) == 0) {
       addr = balloc(ip->dev);
-      if(addr){
-        a[bn] = addr;
-        log_write(bp);
+      
+      if (addr == 0) { // Trong xv6, 0 được dùng như giá trị “không có block / cấp phát thất bại”.
+        brelse(bp);
+        return 0;
       }
+      a[indirect_index] = addr;
+      log_write(bp);
+    }
+    
+    brelse(bp);
+    
+
+    // --- Bước 3c: Load singly-indirect block và tìm data block ---
+    // bn % NINDIRECT = index vào singly-indirect block
+    // Ví dụ: bn=300 → 300%256 = 44 → lấy data block thứ 44
+    bp = bread(ip->dev, addr);
+    a = (uint*)bp->data;
+    
+    data_index = bn % NINDIRECT;
+    
+    if ((addr = a[data_index]) == 0) {
+      addr = balloc(ip->dev);
+      
+      if (addr == 0) {
+        brelse(bp);
+        return 0;
+      }
+      a[data_index] = addr;
+      log_write(bp);
     }
     brelse(bp);
     return addr;
@@ -426,9 +495,10 @@ void
 itrunc(struct inode *ip)
 {
   int i, j;
-  struct buf *bp;
-  uint *a;
+  struct buf *bp, *bp2;
+  uint *a, *a2;
 
+  // === Free direct blocks ===
   for(i = 0; i < NDIRECT; i++){
     if(ip->addrs[i]){
       bfree(ip->dev, ip->addrs[i]);
@@ -436,6 +506,7 @@ itrunc(struct inode *ip)
     }
   }
 
+  // === Free singly-indirect blocks ===
   if(ip->addrs[NDIRECT]){
     bp = bread(ip->dev, ip->addrs[NDIRECT]);
     a = (uint*)bp->data;
@@ -447,6 +518,30 @@ itrunc(struct inode *ip)
     bfree(ip->dev, ip->addrs[NDIRECT]);
     ip->addrs[NDIRECT] = 0;
   }
+  
+  // === Free doubly-indirect blocks ===
+  if (ip->addrs[NDIRECT+1]) {
+    bp = bread(ip->dev, ip->addrs[NDIRECT+1]);
+    a = (uint*)bp->data;
+    
+    for (i = 0; i < NINDIRECT; i++) {
+      if (a[i]) { // a[i] is the disk block address of a singly-indirect block
+        bp2 = bread(ip->dev, a[i]);
+        a2 = (uint*)bp2->data;
+        
+        for (j = 0; j < NINDIRECT; j++) {
+          if (a2[j])
+            bfree(ip->dev, a2[j]);
+        }
+        brelse(bp2);
+        bfree(ip->dev, a[i]);
+        a[i] = 0;
+      }
+    }
+    brelse(bp);
+    bfree(ip->dev, ip->addrs[NDIRECT+1]);
+    ip->addrs[NDIRECT+1] = 0;
+  }
 
   ip->size = 0;
   iupdate(ip);
